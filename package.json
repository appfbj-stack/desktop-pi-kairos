{
  "name": "kairos-pi",
  "version": "0.1.0",
  "private": true,
  "description": "Kairós Desktop Alves — agente de IA desktop para Windows, modelado no Pi Agent, escrito do zero.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "pnpm --filter @kairos/electron dev",
    "build": "pnpm -r build",
    "build:agent": "pnpm --filter @kairos/agent build",
    "build:core": "pnpm --filter @kairos/core build",
    "build:electron": "pnpm --filter @kairos/electron build",
    "release": "node scripts/release.mjs",
    "release:publish": "node scripts/publish-r2.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo && rm -rf node_modules"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "@google/genai",
      "ffmpeg-static",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
