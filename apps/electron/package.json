{
  "name": "@kairos/electron",
  "version": "0.1.0",
  "private": true,
  "description": "Kairós Desktop Alves — shell desktop Electron + React + Vite + Tailwind + Shadcn UI.",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,green \"vite\" \"wait-on http://localhost:5173 && pnpm build:preload && tsc -p tsconfig.node.json && cross-env NODE_ENV=development electron dist/main/index.js\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && pnpm build:preload && tsc -p tsconfig.node.json && cross-env NODE_ENV=development electron dist/main/index.js",
    "build:renderer": "vite build",
    "build:preload": "node build/preload.config.mjs",
    "build:main": "tsc -p tsconfig.node.json",
    "build": "pnpm build:renderer && pnpm build:preload && pnpm build:main",
    "typecheck": "tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "icons": "node build/generate-icon.mjs",
    "vendor": "node build/copy-vendor.mjs",
    "deploy": "pnpm --filter @kairos/electron deploy --legacy --prod ./_deployed",
    "package:win": "cd ./_deployed && pnpm exec electron-builder --win",
    "package:win:dir": "cd ./_deployed && pnpm exec electron-builder --win --dir",
    "package": "pnpm icons && pnpm vendor && pnpm build && pnpm deploy && pnpm package:win",
    "package:dir": "pnpm icons && pnpm vendor && pnpm build && pnpm deploy && pnpm package:win:dir"
  },
  "build": {
    "appId": "com.kairos.desktop.alves",
    "productName": "Kairós Desktop Alves",
    "copyright": "Copyright © 2026 Fernando Borges",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-renderer/**/*",
      "_vendor/**/*",
      "package.json",
      "node_modules/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/better-sqlite3/**",
      "**/pino-pretty/**",
      "**/pino/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kairós Desktop Alves",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": null,
      "uninstallDisplayName": "Kairós Desktop Alves",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@kairos/agent": "workspace:*",
    "@kairos/core": "workspace:*",
    "@kairos/extension-documents": "workspace:*",
    "@kairos/extension-finance": "workspace:*",
    "@kairos/extension-files": "workspace:*",
    "@kairos/extension-images": "workspace:*",
    "@kairos/extension-intelligence": "workspace:*",
    "@kairos/extension-ocr": "workspace:*",
    "@kairos/extension-pdf-create": "workspace:*",
    "@kairos/extension-research": "workspace:*",
    "@kairos/extension-spreadsheets": "workspace:*",
    "@kairos/extension-stream": "workspace:*",
    "@kairos/extension-video": "workspace:*",
    "@kairos/extension-agenda": "workspace:*",
    "highlight.js": "^11.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9",
    "esbuild": "^0.28.2",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
