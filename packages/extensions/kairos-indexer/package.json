{
  "name": "@kairos/extension-indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Indexação automática de pastas + tagging heurístico. Encontre qualquer arquivo instantaneamente.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kairos/agent": "workspace:*",
    "@kairos/core": "workspace:*",
    "better-sqlite3": "^11.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}