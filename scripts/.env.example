# scripts/.env.example
# Copie para scripts/.env e preencha com as credenciais reais do Cloudflare R2.
# NUNCA commite o arquivo .env.

# Cloudflare Account ID — encontra em https://dash.cloudflare.com → R2 → Overview
CLOUDFLARE_ACCOUNT_ID=

# R2 API Token — gera em https://dash.cloudflare.com → R2 → Manage R2 API Tokens
# Permissões: Object Read & Write, scope: bucket específico
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nome do bucket (criar no painel R2 antes de subir arquivos)
R2_BUCKET_NAME=kairos-downloads

# URL público custom (CNAME do domínio pra Cloudflare R2)
# Exemplo: https://download.kairos.com.br
# Se omitido, o script gera URLs com o endpoint padrão do R2 (NÃO recomendado pro cliente final)
R2_PUBLIC_BASE_URL=
