{
  "name": "@kairos/extension-pdf-create",
  "version": "0.1.0",
  "private": true,
  "description": "Kairós PDF creation tools — criar PDFs a partir de texto, tabelas, e mesclar PDFs existentes.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kairos/agent": "workspace:*",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.13.4",
    "typescript": "^5.7.2"
  }
}
